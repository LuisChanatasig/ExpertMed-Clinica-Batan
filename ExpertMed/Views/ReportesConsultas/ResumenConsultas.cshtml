@model ResumenConsultasDto
@using System.Text.Json
@using Microsoft.AspNetCore.Http
@using System.Linq

@{
    ViewData["Title"] = "Dashboard Gerencial";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Inicialización de seguridad
    var kpi = Model?.Kpi ?? new ResumenConsultasDto.DashboardKpi();
    var evolucion = Model?.EvolucionDiaria ?? new List<ResumenConsultasDto.DashboardEvolutionItem>();
    var estados = Model?.EstadoCitas ?? new List<ResumenConsultasDto.DashboardStatusItem>();
    var ranking = Model?.RankingMedicos ?? new List<ResumenConsultasDto.DashboardDoctorItem>();
    var seguros = Model?.PacientesPorSeguro ?? new List<ResumenConsultasDto.DashboardInsuranceItem>();

    var qDesde = Context.Request.Query["fechaDesde"].ToString();
    var qHasta = Context.Request.Query["fechaHasta"].ToString();

    // Lógica Analítica de Negocio
    double tasaAsistencia = kpi.TotalCitas > 0 ? Math.Round((double)kpi.TotalAsistidos * 100 / kpi.TotalCitas, 1) : 0;
    double tasaNoShow = kpi.TotalCitas > 0 ? Math.Round((double)kpi.TotalNoAsistidos * 100 / kpi.TotalCitas, 1) : 0;

    string SafeJson<T>(T obj) => JsonSerializer.Serialize(obj, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="container-fluid mt-3">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-0 text-dark">Control de Mando Operativo</h3>
            <p class="text-muted mb-0">Análisis de rendimiento clínico y asistencia de pacientes.</p>
        </div>
        <div class="d-flex gap-2">
            <div class="bg-white border rounded p-1 d-flex shadow-sm">
                <a class="btn btn-sm btn-ghost-secondary" href="@Url.Action("ResumenConsultas", "Reportes")" title="Recargar">
                    <i class="mdi mdi-refresh fs-5"></i>
                </a>
                <button class="btn btn-sm btn-primary px-3" data-bs-toggle="offcanvas" data-bs-target="#offcanvasFiltros">
                    <i class="mdi mdi-filter-outline me-1"></i> Filtrar Periodo
                </button>
            </div>
            <a class="btn btn-sm btn-success d-flex align-items-center shadow-sm" href="@Url.Action("ExportarResumenConsultasExcel", "Reportes", new { fechaDesde = qDesde, fechaHasta = qHasta })">
                <i class="mdi mdi-file-excel me-1"></i> Exportar
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted text-uppercase fs-11 fw-bold mb-2">Citas Agendadas</p>
                            <h2 class="mb-0 fw-bold">@kpi.TotalCitas</h2>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-primary-subtle text-primary rounded-circle fs-2">
                                <i class="mdi mdi-calendar-multiselect"></i>
                            </span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-muted fs-12">Volumen total de recepción</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 border-bottom border-3 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted text-uppercase fs-11 fw-bold mb-2">Asistencia Confirmada</p>
                            <h2 class="mb-0 fw-bold text-info">@kpi.TotalAsistidos</h2>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-info-subtle text-info rounded-circle fs-2">
                                <i class="mdi mdi-account-check"></i>
                            </span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-info" role="progressbar" style="width: @tasaAsistencia%"></div>
                        </div>
                        <small class="text-muted mt-1 d-block">Tasa de cumplimiento: @tasaAsistencia%</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 border-bottom border-3 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted text-uppercase fs-11 fw-bold mb-2">Consultas Médicas</p>
                            <h2 class="mb-0 fw-bold text-success">@kpi.TotalConsultas</h2>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-success-subtle text-success rounded-circle fs-2">
                                <i class="mdi mdi-stethoscope"></i>
                            </span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-muted fs-12">Atenciones cerradas por médico</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 border-bottom border-3 border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted text-uppercase fs-11 fw-bold mb-2">Ausentismo (No-Show)</p>
                            <h2 class="mb-0 fw-bold text-danger">@kpi.TotalNoAsistidos</h2>
                        </div>
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title bg-danger-subtle text-danger rounded-circle fs-2">
                                <i class="mdi mdi-account-remove"></i>
                            </span>
                        </div>
                    </div>
                    <div class="mt-3 text-danger">
                        <i class="mdi mdi-trending-down"></i> <small class="fw-bold">@tasaNoShow% de citas perdidas</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">Tendencia de Demanda Diaria</h5>
                </div>
                <div class="card-body">
                    <div id="chartEvolution" style="height: 380px;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">Distribución de Estados</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-center">
                    <div id="chartStatus" style="height: 380px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold text-primary">Top 10 Productividad Médica</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="fs-12 text-muted uppercase">
                                <th class="ps-3">MÉDICO RESPONSABLE</th>
                                <th class="text-center">ATENCIONES</th>
                                <th class="text-end pe-4">RENDIMIENTO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ranking.Any())
                            {
                                var maxVal = ranking.Max(x => x.ConsultasRealizadas);
                                foreach (var item in ranking)
                                {
                                    var percent = maxVal > 0 ? (item.ConsultasRealizadas * 100) / maxVal : 0;
                                    <tr>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-xs me-2">
                                                    <span class="avatar-title bg-soft-primary text-primary rounded-circle fs-10">@item.Medico.Substring(0, 1)</span>
                                                </div>
                                                <span class="fw-medium">@item.Medico</span>
                                            </div>
                                        </td>
                                        <td class="text-center fw-bold text-dark">@item.ConsultasRealizadas</td>
                                        <td class="pe-4" style="width: 30%;">
                                            <div class="d-flex align-items-center justify-content-end gap-2">
                                                <div class="progress flex-grow-1" style="height: 5px; max-width: 100px;">
                                                    <div class="progress-bar bg-primary" style="width: @percent%"></div>
                                                </div>
                                                <small class="text-muted">@percent%</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 mb-3 bg-gradient-primary text-white" style="background: linear-gradient(135deg, #405189 0%, #299cdb 100%);">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="fs-13 fw-medium text-white-50 mb-1 text-uppercase">Total Pagado / Facturado</p>
                            <h3 class="mb-0 text-white">@kpi.TotalPagadas <span class="fs-14 fw-normal">Citas</span></h3>
                        </div>
                        <i class="mdi mdi-cash-check fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
            
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold text-info">Pacientes por Aseguradora</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in seguros.Take(5))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-2">
                                <div class="d-flex align-items-center">
                                    <i class="mdi mdi-shield-check-outline text-success me-2 fs-5"></i>
                                    <span class="text-muted fs-13">@item.Seguro</span>
                                </div>
                                <span class="badge bg-light text-dark border">@item.CantidadPacientesUnicos</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" id="offcanvasFiltros">
    <div class="offcanvas-header border-bottom bg-light">
        <h5 class="offcanvas-title fw-bold">Parámetros del Dashboard</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form method="get" asp-action="ResumenConsultas">
            <div class="mb-3">
                <label class="form-label fw-medium">Desde</label>
                <input type="date" class="form-control" name="fechaDesde" value="@qDesde" />
            </div>
            <div class="mb-4">
                <label class="form-label fw-medium">Hasta</label>
                <input type="date" class="form-control" name="fechaHasta" value="@qHasta" />
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary shadow">Actualizar Reporte</button>
                <a href="@Url.Action("ResumenConsultas")" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const dataEvolution = @Html.Raw(SafeJson(evolucion));
        const dataStatus = @Html.Raw(SafeJson(estados));

        // Gráfico de Tendencia
        const chartEv = echarts.init(document.getElementById('chartEvolution'));
        chartEv.setOption({
        tooltip: { trigger: 'axis', backgroundColor: 'rgba(255, 255, 255, 0.9)', textStyle: { color: '#333' } },
        grid: { left: '2%', right: '3%', bottom: '5%', top: '5%', containLabel: true },
        xAxis: { type: 'category', boundaryGap: false, data: dataEvolution.map(i => i.fecha.substring(0, 10)), axisLine: { lineStyle: { color: '#eee' } } },
        yAxis: { type: 'value', splitLine: { lineStyle: { type: 'dashed', color: '#eee' } } },
        series: [{
        name: 'Citas', type: 'line', smooth: true, symbol: 'circle', symbolSize: 8,
        lineStyle: { width: 3, color: '#405189' },
        itemStyle: { color: '#405189' },
        areaStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{offset: 0, color: 'rgba(64,81,137,0.2)'}, {offset: 1, color: 'transparent'}]) },
        data: dataEvolution.map(i => i.cantidadCitas)
        }]
        });

        // Gráfico de Pastel
        const chartSt = echarts.init(document.getElementById('chartStatus'));
        chartSt.setOption({
        tooltip: { trigger: 'item' },
        legend: { bottom: '0%', left: 'center', itemWidth: 10, itemHeight: 10, textStyle: { fontSize: 11 } },
        series: [{
        name: 'Estatus', type: 'pie', radius: ['45%', '75%'], avoidLabelOverlap: false,
        itemStyle: { borderRadius: 6, borderColor: '#fff', borderWidth: 2 },
        label: { show: false },
        data: dataStatus.map(i => {
        let c = '#405189';
        if(i.estado.includes('Fin')) c = '#0ab39c';
        if(i.estado.includes('Can')) c = '#f06548';
        if(i.estado.includes('Act')) c = '#299cdb';
        return { value: i.cantidad, name: i.estado, itemStyle: { color: c } };
        })
        }]
        });

        window.addEventListener('resize', () => { chartEv.resize(); chartSt.resize(); });
        });
    </script>
}