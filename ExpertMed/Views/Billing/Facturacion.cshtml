@{
    ViewData["Title"] = "Facturacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<input type="hidden" id="hasInsurance" value="@ViewBag.HasInsurance.ToString().ToLower()" />
<input type="hidden" id="insuranceCompanyId" value="@ViewBag.InsuranceCompanyId" />
<input type="hidden" id="AppointmentPatientId" value="@ViewBag.AppointmentPatientId" />

<div class="col-xl-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title mb-0">Generación de pago</h4>
        </div>
        <div class="card-body">
            <div class="step-arrow-nav mb-4">
                <ul class="nav nav-pills custom-nav nav-justified" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="efectivo-tab" data-bs-toggle="pill"
                            data-bs-target="#efectivo" type="button" role="tab">
                            Efectivo
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="transferencia-tab" data-bs-toggle="pill"
                            data-bs-target="#transferencia" type="button" role="tab">
                            Transferencia
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tarjeta-tab" data-bs-toggle="pill" data-bs-target="#tarjeta"
                            type="button" role="tab">
                            Tarjeta
                        </button>
                    </li>
                </ul>
            </div>

            <div class="tab-content">
                @foreach (var metodo in new[] { "efectivo", "transferencia", "tarjeta_credito" })
                {
                    var tabId = metodo == "efectivo" ? "efectivo" : metodo == "transferencia" ? "transferencia" : "tarjeta";
                    <div class="tab-pane fade show @(metodo == "efectivo" ? "active" : "")" id="@tabId" role="tabpanel">
                        <form asp-action="Billing" asp-controller="Billing" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="CitaId" value="@ViewBag.AppointmentId" />
                            <input type="hidden" name="AppointmentPatientId" value="@ViewBag.AppointmentPatientId" />
                            <input type="hidden" name="MetodoPago" value="@metodo" />

                            @if (metodo != "efectivo")
                            {
                                <div class="mb-3">
                                    <label for="comprobantePagoFile-@tabId" class="form-label">Comprobante de Pago</label>
                                    <input type="file" id="comprobantePagoFile-@tabId" name="comprobantePagoFile"
                                        accept=".jpeg,.jpg,.png" class="form-control" required />
                                </div>
                            }

                            <div class="row mb-3">
                                <div class="col">
                                    <button type="button" class="btn btn-outline-primary w-100"
                                        onclick="cargarDatosPaciente(this)">
                                        <i class="ri-user-line align-middle"></i> Mismos datos del paciente
                                    </button>
                                </div>
                                <div class="col">
                                    <button type="button" class="btn btn-outline-secondary w-100" data-bs-toggle="collapse"
                                        data-bs-target="#facturacion-extra-@metodo" onclick="limpiarFormulario(this)">
                                        <i class="ri-edit-box-line align-middle"></i> Otros datos
                                    </button>
                                </div>
                            </div>

                            <div class="collapse" id="facturacion-extra-@metodo">
                                <div class="card card-body mb-3">
                                    <h5 class="card-title mb-3">Datos de Facturación</h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <input type="text" class="form-control fact-input" name="BillingDetailsNames"
                                                placeholder="Nombre completo">
                                        </div>
                                        <div class="col-md-6">
                                            <input type="text" class="form-control fact-input" name="BillingDetailsCiNumber"
                                                placeholder="Identificación">
                                        </div>
                                        <div class="col-md-6">
                                            <select class="form-control fact-input" name="BillingDetailsDocumentType">
                                                <option value="">Seleccione un tipo de documento</option>
                                                <option value="05">Cédula</option>
                                                <option value="04">RUC</option>
                                                <option value="06">Pasaporte</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <input type="email" class="form-control fact-input" name="BillingDetailsEmail"
                                                placeholder="Correo electrónico">
                                        </div>
                                        <div class="col-md-6">
                                            <input type="text" class="form-control fact-input" name="BillingDetailsAddress"
                                                placeholder="Dirección">
                                        </div>
                                        <div class="col-md-6">
                                            <input type="tel" class="form-control fact-input" name="BillingDetailsPhone"
                                                placeholder="Teléfono">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Detalle de servicios</label>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Descripción</th>
                                            <th>Cantidad</th>
                                            <th>Precio Unitario</th>
                                            <th class="col-insurance d-none">Valor Aseguradora</th>
                                            <th class="col-insurance d-none">Copago</th>
                                            <th>Total</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody id="invoice-items-body-@tabId"></tbody>
                                </table>
                                <button type="button" class="btn btn-outline-success" onclick="agregarItem(this)">
                                    + Agregar
                                    ítem
                                </button>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <label class="form-label">Total Aseguradora</label>
                                    <input type="text" class="form-control" name="TotalAseguradora"
                                        id="totalAseguradora-@tabId" readonly>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Total Copago (Paciente)</label>
                                    <input type="text" class="form-control" name="TotalCopago" id="totalCopago-@tabId"
                                        readonly>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Total Factura</label>
                                    <input type="text" class="form-control" name="TotalFactura" id="totalFactura-@tabId"
                                        readonly required>
                                </div>
                            </div>


                            <button type="submit" class="btn btn-success">Registrar Pago</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        const tieneSeguro = document.getElementById("hasInsurance").value === "true";
        const insuranceCompanyId = document.getElementById("insuranceCompanyId").value;
        let contador = 0;

        // Función auxiliar para normalizar los valores de entrada (reemplazar coma por punto)
        function normalizeNumberInput(value) {
            if (typeof value === 'string') {
                return value.replace(",", ".");
            }
            return value;
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (tieneSeguro) {
                document.querySelectorAll(".col-insurance").forEach(el => el.classList.remove("d-none"));
            }

            document.querySelectorAll("form").forEach(form => {
                form.addEventListener("submit", function (e) {
                    const filas = form.querySelectorAll("tbody tr");
                    if (filas.length === 0) {
                        e.preventDefault();
                        Swal.fire('Error', 'Debes agregar al menos un ítem a la factura.', 'warning');
                        return;
                    }

                    let valido = true;

                    console.log("🧾 Detalle de ítems que se van a enviar:");
                    filas.forEach((fila, idx) => {
                        const desc = fila.querySelector(".descripcion-select")?.value.trim();
                        const cantInput = fila.querySelector(".cantidad");
                        const precioInput = fila.querySelector(".precio");
                        const seguroInput = fila.querySelector(".precio-seguro");
                        const copagoInput = fila.querySelector(".copago");
                        const totalInput = fila.querySelector(".total-item");

                        const cant = parseFloat(normalizeNumberInput(cantInput?.value));
                        const precio = parseFloat(normalizeNumberInput(precioInput?.value));
                        const seguro = parseFloat(normalizeNumberInput(seguroInput?.value));
                        const copago = parseFloat(normalizeNumberInput(copagoInput?.value));
                        const total = parseFloat(normalizeNumberInput(totalInput?.value));

                        console.log(`Fila ${idx + 1}:`);
                        console.log(`🟩 Descripción: ${desc}`);
                        console.log(`📌 Cantidad: ${cant}`);
                        console.log(`💲 Precio Unitario: ${precio}`);
                        console.log(`🏥 Aseguradora: ${seguro}`);
                        console.log(`🧾 Copago: ${copago}`);
                        console.log(`📦 Total por ítem: ${total}`);

                        if (!desc || isNaN(cant) || cant <= 0 || isNaN(precio) || precio <= 0) {
                            valido = false;
                        }
                    });

                    if (!valido) {
                        e.preventDefault();
                        Swal.fire('Error', 'Verifica que todos los ítems tengan descripción, cantidad y precio válidos.', 'warning');
                        return;
                    }

                    // Mostrar totales finales por pestaña
                    console.log("📊 Totales por pestaña:");
                    document.querySelectorAll(".tab-pane").forEach(tab => {
                        const tabId = tab.id;
                        const inputFactura = document.getElementById(`totalFactura-${tabId}`);
                        const inputAseguradora = document.getElementById(`totalAseguradora-${tabId}`);
                        const inputCopago = document.getElementById(`totalCopago-${tabId}`);

                        if (inputFactura && inputAseguradora && inputCopago) {
                            console.log(`🧾 Tab: ${tabId}`);
                            console.log(`🔹 Total Factura: ${inputFactura.value}`);
                            console.log(`🔹 Total Aseguradora: ${inputAseguradora.value}`);
                            console.log(`🔹 Total Copago: ${inputCopago.value}`);
                        }
                    });

                    // También podemos capturar el FormData si es envío tradicional
                    const formData = new FormData(form);
                    console.log("📤 Contenido exacto del FormData que se va al backend:");
                    for (const [key, value] of formData.entries()) {
                        console.log(`${key}: ${value}`);
                    }
                });
            });
        });

        function agregarItem(btn) {
            const tabContent = btn.closest('.tab-pane');
            const tbody = tabContent.querySelector('tbody');
            const tabId = tabContent.id;
            const index = contador++;
            const row = document.createElement('tr');

            row.innerHTML = `
                        <td>
                            <select class="form-control descripcion-select"
                                    name="Items[${index}].DescripcionVisible"
                                    placeholder="Buscar procedimiento" required></select>
                        </td>
                        <td>
                            <input type="text" class="form-control cantidad" name="Items[${index}].Quantity"
                                   min="1" value="1" onchange="recalcularItem(this)" required>
                        </td>
                        <td>
                            <input type="text" class="form-control precio" name="Items[${index}].UnitPrice"
                                   min="0" step="0.01" value="8.00" onchange="recalcularItem(this)" required>
                        </td>
                        <td class="col-insurance">
                            <input type="text" class="form-control precio-seguro" name="Items[${index}].Aseguradora"
                                   min="0" step="0.01" value="8.00" onchange="recalcularItem(this)" />
                        </td>
                        <td class="col-insurance">
                            <input type="text" class="form-control copago" readonly step="0.01" tabindex="-1" />
                        </td>
                        <td><input type="text" class="form-control total-item" value="0.00" step="0.01" readonly></td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm" onclick="eliminarItem(this)">🖑</button>
                        </td>
                    `;

            tbody.appendChild(row);

            if (tieneSeguro) {
                row.querySelectorAll(".col-insurance").forEach(td => td.classList.remove("d-none"));
            }

            const select = row.querySelector(".descripcion-select");
            $(select).select2({
                placeholder: "Buscar procedimiento",
                minimumInputLength: 2,
                width: '100%',
                ajax: {
                    url: '@Url.Action("BuscarProcedimientos", "Tarifario")',
                    data: function (params) {
                        return {
                            termino: params.term,
                            insuranceCompanyId: insuranceCompanyId
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data
                        };
                    }
                }
            }).on('select2:select', function (e) {
                const selected = e.params.data;
                const fila = e.target.closest("tr");
                const filaIndex = Array.from(fila.parentNode.children).indexOf(fila);

                let hiddenCode = fila.querySelector(`input[name="Items[${filaIndex}].Code"]`);
                if (!hiddenCode) {
                    hiddenCode = document.createElement('input');
                    hiddenCode.type = 'hidden';
                    hiddenCode.name = `Items[${filaIndex}].Code`;
                    fila.appendChild(hiddenCode);
                }
                hiddenCode.value = selected.id || "";

                let hiddenDescription = fila.querySelector(`input[name="Items[${filaIndex}].Description"]`);
                if (!hiddenDescription) {
                    hiddenDescription = document.createElement('input');
                    hiddenDescription.type = 'hidden';
                    hiddenDescription.name = `Items[${filaIndex}].Description`;
                    fila.appendChild(hiddenDescription);
                }
                hiddenDescription.value = selected.text || "";

                // Aplicar normalización a selected.precio_aseguradora antes de parsear
                let bruto = normalizeNumberInput(selected.precio_aseguradora?.toString() || "0");
                const precioRef = parseFloat(bruto) || 0;

                const precioInput = fila.querySelector(".precio");
                const seguroInput = fila.querySelector(".precio-seguro");

                if (precioInput) precioInput.value = precioRef.toFixed(2);
                if (seguroInput) seguroInput.value = precioRef.toFixed(2);

                recalcularItem(seguroInput);
            });
        }

        function eliminarItem(btn) {
            btn.closest('tr').remove();
            recalcularTotal();
        }

        function recalcularItem(elemento) {
            const fila = elemento.closest('tr');
            // Normalizar valores antes de parsear
            const cantidad = parseFloat(normalizeNumberInput(fila.querySelector('.cantidad')?.value || 0));
            const precioUnitario = parseFloat(normalizeNumberInput(fila.querySelector('.precio')?.value || 0));
            const valorSeguroInput = fila.querySelector('.precio-seguro');

            let valorSeguro = parseFloat(normalizeNumberInput(valorSeguroInput?.value || 0));

            if (valorSeguro > precioUnitario) {
                valorSeguro = precioUnitario;
                if (valorSeguroInput) valorSeguroInput.value = valorSeguro.toFixed(2);
                Swal.fire('Aviso', 'El valor aseguradora no puede ser mayor al precio unitario.', 'warning');
            }

            const copago = precioUnitario - valorSeguro;
            const copagoInput = fila.querySelector('.copago');
            if (copagoInput) copagoInput.value = copago.toFixed(2);

            calcularSubtotalFila(fila, precioUnitario, cantidad);
        }

        function calcularSubtotalFila(fila, precio, cantidad) {
            const subtotal = precio * cantidad;
            const totalItemInput = fila.querySelector('.total-item');
            if (totalItemInput) totalItemInput.value = subtotal.toFixed(2);
            recalcularTotal();
        }

        function recalcularTotal() {
            document.querySelectorAll(".tab-pane").forEach(tab => {
                const tabId = tab.id;
                let totalFactura = 0;
                let totalAseguradora = 0;
                let totalCopago = 0;

                tab.querySelectorAll("tbody tr").forEach(fila => {
                    const cantidad = parseFloat(normalizeNumberInput(fila.querySelector(".cantidad")?.value || 0));
                    const precioUnitario = parseFloat(normalizeNumberInput(fila.querySelector(".precio")?.value || 0));
                    const valorSeguro = parseFloat(normalizeNumberInput(fila.querySelector(".precio-seguro")?.value || 0));
                    const copago = parseFloat(normalizeNumberInput(fila.querySelector(".copago")?.value || 0));

                    const parcial = cantidad * precioUnitario;
                    totalFactura += parcial;
                    totalAseguradora += cantidad * valorSeguro;
                    totalCopago += cantidad * copago;

                    console.log(`▶️ ${cantidad} x ${precioUnitario} = ${parcial}`);
                });

                console.log(`💰 [${tabId}] total calculado: ${totalFactura}`);

                const inputFactura = document.getElementById(`totalFactura-${tabId}`);
                const inputAseguradora = document.getElementById(`totalAseguradora-${tabId}`);
                const inputCopago = document.getElementById(`totalCopago-${tabId}`);

                if (inputFactura) {
                    inputFactura.value = totalFactura.toFixed(2);
                    console.log("🧾 Asignado al input:", inputFactura.value);
                }

                if (inputAseguradora) inputAseguradora.value = totalAseguradora.toFixed(2);
                if (inputCopago) inputCopago.value = totalCopago.toFixed(2);
            });
        }


        document.addEventListener("focusin", function (e) {
            if (e.target.classList.contains("descripcion-select") && !e.target.dataset.select2initialized) {
                $(e.target).select2({
                    placeholder: "Buscar procedimiento",
                    minimumInputLength: 2,
                    ajax: {
                        url: '@Url.Action("BuscarProcedimientos", "Tarifario")',
                        data: function (params) {
                            return {
                                termino: params.term,
                                insuranceCompanyId: insuranceCompanyId
                            };
                        },
                        processResults: function (data) {
                            return {
                                results: data
                            };
                        }
                    }
                }).on('select2:select', function (e) {
                    const fila = e.target.closest("tr");
                    const selected = e.params.data;
                    const index = Array.from(fila.parentNode.children).indexOf(fila);

                    let hiddenInput = fila.querySelector(`input[name="Items[${index}].Code"]`);
                    if (!hiddenInput) {
                        hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = `Items[${index}].Code`;
                        fila.appendChild(hiddenInput);
                    }
                    hiddenInput.value = selected.id || "";

                    e.target.name = `Items[${index}].Description`;

                    // Aplicar normalización a selected.precio_aseguradora antes de parsear
                    let bruto = normalizeNumberInput(selected.precio_aseguradora?.toString() || "0");
                    const valorSeguro = parseFloat(bruto) || 0;

                    // Normalizar valor del input de precio antes de parsear
                    const precioUnitario = parseFloat(normalizeNumberInput(fila.querySelector(".precio")?.value || 0));
                    const copago = precioUnitario - valorSeguro;

                    const precioSeguroInput = fila.querySelector(".precio-seguro");
                    const copagoInput = fila.querySelector(".copago");

                    if (precioSeguroInput && copagoInput) {
                        precioSeguroInput.value = valorSeguro.toFixed(2);
                        copagoInput.value = copago.toFixed(2);
                    }

                    // Normalizar valor del input de cantidad antes de parsear
                    const cantidad = parseFloat(normalizeNumberInput(fila.querySelector(".cantidad")?.value || 1));
                    const precioActual = parseFloat(normalizeNumberInput(fila.querySelector(".precio")?.value || 0)); // Volver a leer y normalizar
                    calcularSubtotalFila(fila, precioActual, cantidad);
                });

                e.target.dataset.select2initialized = "true";
            }
        });
    </script>
    <script>
        function cargarDatosPaciente(btn) {
            const patientId = parseInt(document.getElementById("AppointmentPatientId").value, 10);
            const form = btn.closest('form');

            if (!patientId) {
                alert("No se encontró el ID del paciente.");
                return;
            }

            fetch(`@Url.Action("GetPatientDetails", "Patient")?patientId=${patientId}`)
                .then(r => r.json())
                .then(data => {
                    const campos = {
                        BillingDetailsNames: data.patientFirstname + ' ' + data.patientFirstsurname,
                        BillingDetailsCiNumber: data.patientDocumentnumber,
                        BillingDetailsDocumentType: data.patientDocumentType,
                        BillingDetailsEmail: data.patientEmail,
                        BillingDetailsAddress: data.patientAddress,
                        BillingDetailsPhone: data.patientCellularPhone
                    };

                    for (const name in campos) {
                        const input = form.querySelector(`[name="${name}"]`);
                        if (input) input.value = campos[name];
                    }

                    const collapseDiv = form.querySelector('.collapse');
                    if (collapseDiv) new bootstrap.Collapse(collapseDiv, { toggle: true });
                })
                .catch(() => alert('Hubo un error al obtener los datos del paciente.'));
        }



    </script>

}
