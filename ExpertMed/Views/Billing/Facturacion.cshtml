@{
    ViewData["Title"] = "Facturacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<input type="hidden" id="hasInsurance" value="@ViewBag.HasInsurance.ToString().ToLower()" />
<input type="hidden" id="insuranceCompanyId" value="@ViewBag.InsuranceCompanyId" />
<input type="hidden" id="AppointmentPatientId" value="@ViewBag.AppointmentPatientId" />

<div class="col-xl-12">
    <div class="card">
        <div class="card-header">
            <h4 class="card-title mb-0">Generación de Factura y Pago</h4>
        </div>
        <div class="card-body">
            <form asp-action="Billing" asp-controller="Billing" method="post" enctype="multipart/form-data" id="billingForm">
                <input type="hidden" name="CitaId" value="@ViewBag.AppointmentId" />
                <input type="hidden" name="AppointmentPatientId" value="@ViewBag.AppointmentPatientId" />
                <input type="hidden" id="insuranceCompanyId" value="@ViewBag.InsuranceCompanyId" />

                <!-- Sección: Datos de Facturación -->
                <div class="mb-4">
                    <h5 class="mb-3">Datos de Facturación</h5>
                    <div class="row mb-3">
                        <div class="col">
                            <button type="button" class="btn btn-outline-primary w-100" onclick="cargarDatosPaciente()">
                                <i class="ri-user-line align-middle"></i> Mismos datos del paciente
                            </button>
                        </div>
                        <div class="col">
                            <button type="button" class="btn btn-outline-secondary w-100" data-bs-toggle="collapse"
                                    data-bs-target="#facturacion-extra" onclick="limpiarFormulario()">
                                <i class="ri-edit-box-line align-middle"></i> Otros datos
                            </button>
                        </div>
                    </div>

                    <div class="collapse" id="facturacion-extra">
                        <div class="card card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Nombre completo</label>
                                    <input type="text" class="form-control" name="BillingDetailsNames" placeholder="Nombre completo">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Identificación</label>
                                    <input type="text" class="form-control" name="BillingDetailsCiNumber" placeholder="Identificación">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Tipo de Documento</label>
                                    <select class="form-control" name="BillingDetailsDocumentType" required>
                                        <option value="05" selected>Cédula</option>
                                        <option value="04">RUC</option>
                                        <option value="06">Pasaporte</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Correo Electrónico</label>
                                    <input type="email" class="form-control" name="BillingDetailsEmail" placeholder="correo@ejemplo.com">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Dirección</label>
                                    <input type="text" class="form-control" name="BillingDetailsAddress" placeholder="Dirección">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Teléfono</label>
                                    <input type="tel" class="form-control" name="BillingDetailsPhone" placeholder="Teléfono">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sección: Servicios -->
                <div class="mb-4">
                    <h5 class="mb-3">Detalle de Servicios</h5>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Descripción</th>
                                    <th>Cantidad</th>
                                    <th>Precio Unitario</th>
                                    <th class="col-insurance d-none">Valor Aseguradora</th>
                                    <th class="col-insurance d-none">Copago</th>
                                    <th>Descuento (%)</th>
                                    <th>Total</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="invoice-items-body"></tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-outline-success" onclick="agregarItem()">
                        + Agregar ítem
                    </button>
                </div>

                <!-- Sección: Métodos de Pago -->
                <div class="mb-4">
                    <h5 class="mb-3">Métodos de Pago</h5>
                    <div class="alert alert-info">
                        <i class="ri-information-line"></i> Puede agregar múltiples métodos de pago. La suma debe coincidir con el total de la factura.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Método de Pago</th>
                                    <th>Monto</th>
                                    <th>Comprobante</th>
                                    <th>Notas</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="payment-methods-body"></tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-outline-primary" onclick="agregarMetodoPago()">
                        + Agregar Método de Pago
                    </button>
                </div>

                <!-- Resumen de Totales -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label">Total Aseguradora</label>
                        <input type="text" class="form-control" id="totalAseguradora" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Total Copago (Paciente)</label>
                        <input type="text" class="form-control" id="totalCopago" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Total Factura</label>
                        <input type="text" class="form-control" name="TotalFactura" id="totalFactura" readonly required>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="alert alert-warning">
                            <strong>Pendiente por pagar: $<span id="total-pendiente">0.00</span></strong>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-success btn-lg">
                    <i class="ri-save-line"></i> Generar Factura y Registrar Pago
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const tieneSeguro = document.getElementById("hasInsurance").value === "true";
        const insuranceCompanyId = document.getElementById("insuranceCompanyId").value;
        let contadorItems = 0;
        let contadorPagos = 0;

        // Opciones de métodos de pago según Dátil
        const paymentOptions = [
            { value: 'efectivo', text: 'Efectivo' },
            { value: 'transferencia', text: 'Transferencia bancaria' },
            { value: 'tarjeta_debito', text: 'Tarjeta de débito' },
            { value: 'tarjeta_prepago', text: 'Tarjeta prepago' },
            { value: 'tarjeta_credito', text: 'Tarjeta de crédito' },
            { value: 'otros', text: 'Otros' },
            { value: 'endoso_titulos', text: 'Endoso de títulos' }
        ];

        // Función auxiliar para normalizar valores numéricos
        function normalizeNumberInput(value) {
            if (typeof value === 'string') {
                return value.replace(",", ".");
            }
            return value;
        }

        // Inicialización al cargar el DOM
        document.addEventListener("DOMContentLoaded", () => {
            if (tieneSeguro) {
                document.querySelectorAll(".col-insurance").forEach(el => el.classList.remove("d-none"));
            }

            // Validación del formulario
            document.getElementById('billingForm').addEventListener('submit', function(e) {
                const filas = document.querySelectorAll("#invoice-items-body tr");
                if (filas.length === 0) {
                    e.preventDefault();
                    Swal.fire('Error', 'Debes agregar al menos un ítem a la factura.', 'warning');
                    return false;
                }

                const paymentRows = document.querySelectorAll("#payment-methods-body tr");
                if (paymentRows.length === 0) {
                    e.preventDefault();
                    Swal.fire('Error', 'Debes agregar al menos un método de pago.', 'warning');
                    return false;
                }

                if (!validarTotalPagos()) {
                    e.preventDefault();
                    Swal.fire('Error', 'La suma de los métodos de pago debe coincidir exactamente con el total de la factura.', 'error');
                    return false;
                }

                // Validar items
                let valido = true;
                filas.forEach((fila) => {
                    const desc = fila.querySelector(".descripcion-select")?.value.trim();
                    const cant = parseFloat(normalizeNumberInput(fila.querySelector(".cantidad")?.value));
                    const precio = parseFloat(normalizeNumberInput(fila.querySelector(".precio")?.value));

                    if (!desc || isNaN(cant) || cant <= 0 || isNaN(precio) || precio <= 0) {
                        valido = false;
                    }
                });

                if (!valido) {
                    e.preventDefault();
                    Swal.fire('Error', 'Verifica que todos los ítems tengan descripción, cantidad y precio válidos.', 'warning');
                    return false;
                }
            });
        });

        // Agregar ítem de servicio
        function agregarItem() {
            const tbody = document.getElementById('invoice-items-body');
            const index = contadorItems++;
            const row = document.createElement('tr');

            row.innerHTML = `
                <td>
                    <select class="form-control descripcion-select"
                            name="Items[${index}].DescripcionVisible"
                            placeholder="Buscar procedimiento" required></select>
                </td>
                <td>
                    <input type="number" class="form-control cantidad" name="Items[${index}].Quantity"
                           min="1" value="1" onchange="recalcularItem(this)" required>
                </td>
                <td>
                    <input type="number" class="form-control precio" name="Items[${index}].UnitPrice"
                           min="0" step="0.01" value="0.00" onchange="recalcularItem(this)" required>
                </td>
                <td class="col-insurance ${tieneSeguro ? '' : 'd-none'}">
                    <input type="number" class="form-control precio-seguro" name="Items[${index}].Aseguradora"
                           min="0" step="0.01" value="0.00" onchange="recalcularItem(this)" />
                </td>
                <td class="col-insurance ${tieneSeguro ? '' : 'd-none'}">
                    <input type="number" class="form-control copago" value="0.00" step="0.01" readonly />
                </td>
                <td>
                    <input type="number" class="form-control descuento-item"
                           name="Items[${index}].DescuentoPorcentaje"
                           value="0" min="0" max="100" step="0.01"
                           onchange="recalcularItem(this)">
                </td>
                <td><input type="number" class="form-control total-item" value="0.00" step="0.01" readonly></td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="eliminarItem(this)">
                        <i class="ri-delete-bin-line"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);

            const select = row.querySelector(".descripcion-select");
            $(select).select2({
                placeholder: "Buscar procedimiento",
                minimumInputLength: 2,
                width: '100%',
                ajax: {
                    url: '@Url.Action("BuscarProcedimientos", "Tarifario")',
                    data: function (params) {
                        return {
                            termino: params.term,
                            insuranceCompanyId: insuranceCompanyId
                        };
                    },
                    processResults: function (data) {
                        return { results: data };
                    }
                }
            }).on('select2:select', function (e) {
                const selected = e.params.data;
                const fila = e.target.closest("tr");
                const filaIndex = Array.from(fila.parentNode.children).indexOf(fila);

                let hiddenCode = fila.querySelector(`input[name="Items[${filaIndex}].Code"]`);
                if (!hiddenCode) {
                    hiddenCode = document.createElement('input');
                    hiddenCode.type = 'hidden';
                    hiddenCode.name = `Items[${filaIndex}].Code`;
                    fila.appendChild(hiddenCode);
                }
                hiddenCode.value = selected.id || "";

                let hiddenDescription = fila.querySelector(`input[name="Items[${filaIndex}].Description"]`);
                if (!hiddenDescription) {
                    hiddenDescription = document.createElement('input');
                    hiddenDescription.type = 'hidden';
                    hiddenDescription.name = `Items[${filaIndex}].Description`;
                    fila.appendChild(hiddenDescription);
                }
                hiddenDescription.value = selected.text || "";

                const precioRef = parseFloat(normalizeNumberInput(selected.precio_aseguradora?.toString() || "0")) || 0;
                const precioInput = fila.querySelector(".precio");
                const seguroInput = fila.querySelector(".precio-seguro");

                if (precioInput) precioInput.value = precioRef.toFixed(2);
                if (seguroInput) seguroInput.value = precioRef.toFixed(2);

                recalcularItem(seguroInput);
            });
        }

        function eliminarItem(btn) {
            btn.closest('tr').remove();
            recalcularTotal();
        }

        function recalcularItem(elemento) {
            const fila = elemento.closest('tr');
            const cantidad = parseFloat(normalizeNumberInput(fila.querySelector('.cantidad')?.value || 0));
            const precioUnitario = parseFloat(normalizeNumberInput(fila.querySelector('.precio')?.value || 0));
            const valorSeguroInput = fila.querySelector('.precio-seguro');
            let valorSeguro = parseFloat(normalizeNumberInput(valorSeguroInput?.value || 0));

            if (valorSeguro > precioUnitario) {
                valorSeguro = precioUnitario;
                if (valorSeguroInput) valorSeguroInput.value = valorSeguro.toFixed(2);
                Swal.fire('Aviso', 'El valor aseguradora no puede ser mayor al precio unitario.', 'warning');
            }

            const descuentoInput = fila.querySelector('.descuento-item');
            let descuentoPorcentaje = parseFloat(normalizeNumberInput(descuentoInput?.value || 0));
            if (descuentoPorcentaje < 0) descuentoPorcentaje = 0;
            if (descuentoPorcentaje > 100) descuentoPorcentaje = 100;

            const precioConDescuento = precioUnitario - (precioUnitario * descuentoPorcentaje / 100);
            const copago = precioConDescuento - valorSeguro;

            const copagoInput = fila.querySelector('.copago');
            if (copagoInput) copagoInput.value = copago.toFixed(2);

            const subtotal = precioConDescuento * cantidad;
            const totalItemInput = fila.querySelector('.total-item');
            if (totalItemInput) totalItemInput.value = subtotal.toFixed(2);

            recalcularTotal();
        }

        function recalcularTotal() {
            let totalFactura = 0;
            let totalAseguradora = 0;
            let totalCopago = 0;

            document.querySelectorAll("#invoice-items-body tr").forEach(fila => {
                const cantidad = parseFloat(normalizeNumberInput(fila.querySelector(".cantidad")?.value || 0));
                const precioUnitario = parseFloat(normalizeNumberInput(fila.querySelector(".precio")?.value || 0));
                const valorSeguro = parseFloat(normalizeNumberInput(fila.querySelector(".precio-seguro")?.value || 0));
                const copago = parseFloat(normalizeNumberInput(fila.querySelector(".copago")?.value || 0));

                const parcial = cantidad * precioUnitario;
                totalFactura += parcial;
                totalAseguradora += cantidad * valorSeguro;
                totalCopago += cantidad * copago;
            });

            document.getElementById('totalFactura').value = totalFactura.toFixed(2);
            document.getElementById('totalAseguradora').value = totalAseguradora.toFixed(2);
            document.getElementById('totalCopago').value = totalCopago.toFixed(2);

            validarTotalPagos();
        }

        // Agregar método de pago
        function agregarMetodoPago() {
            const tbody = document.getElementById('payment-methods-body');
            const index = contadorPagos++;
            const totalFactura = parseFloat(document.getElementById('totalFactura').value || 0);

            const optionsHtml = paymentOptions.map(opt =>
                `<option value="${opt.value}">${opt.text}</option>`
            ).join('');

            const row = document.createElement('tr');
            row.innerHTML = `
                <td>
                    <select class="form-control" name="PaymentMethods[${index}].PaymentMethod" required>
                        ${optionsHtml}
                    </select>
                </td>
                <td>
                    <input type="number" class="form-control payment-amount"
                           name="PaymentMethods[${index}].PaymentAmount"
                           step="0.01" min="0.01" max="${totalFactura}"
                           onchange="validarTotalPagos()" required>
                </td>
                <td>
                   <input type="file" class="form-control payment-proof-file"
        name="PaymentMethods[${index}].PaymentProof"
        id="paymentProof${index}"
        accept=".jpeg,.jpg,.png,.pdf">

                </td>
                <td>
                    <input type="text" class="form-control"
                           name="PaymentMethods[${index}].PaymentNotes"
                           placeholder="Notas opcionales">
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="eliminarMetodoPago(this)">
                        <i class="ri-delete-bin-line"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);
            validarTotalPagos();
        }

        function eliminarMetodoPago(btn) {
            btn.closest('tr').remove();
            validarTotalPagos();
        }

        function validarTotalPagos() {
            const totalFactura = parseFloat(document.getElementById('totalFactura').value || 0);
            let totalPagos = 0;

            document.querySelectorAll('.payment-amount').forEach(input => {
                totalPagos += parseFloat(input.value || 0);
            });

            const pendiente = totalFactura - totalPagos;
            const pendienteElement = document.getElementById('total-pendiente');

            if (pendienteElement) {
                pendienteElement.textContent = Math.abs(pendiente).toFixed(2);
                const alert = pendienteElement.closest('.alert');

                if (Math.abs(pendiente) > 0.01) {
                    alert.classList.remove('alert-success');
                    alert.classList.add('alert-warning');
                } else {
                    alert.classList.remove('alert-warning');
                    alert.classList.add('alert-success');
                }
            }

            return Math.abs(pendiente) < 0.01;
        }

        // Cargar datos del paciente
        function cargarDatosPaciente() {
            const patientId = parseInt(document.getElementById("AppointmentPatientId").value, 10);

            if (!patientId) {
                Swal.fire('Error', 'No se encontró el ID del paciente.', 'error');
                return;
            }

            fetch(`@Url.Action("GetPatientDetails", "Patient")?patientId=${patientId}`)
                .then(r => r.json())
                .then(data => {
                    const form = document.getElementById('billingForm');
                    const campos = {
                        BillingDetailsNames: (
                            (data.patientFirstsurname ?? '') + ' ' +
                            (data.patientSecondlastname ?? '') + ' ' +
                            (data.patientFirstname ?? '') + ' ' +
                            (data.patientMiddlename ?? '')
                        ).trim(),
                        BillingDetailsCiNumber: data.patientDocumentnumber,
                        BillingDetailsDocumentType: data.patientDocumentType,
                        BillingDetailsEmail: data.patientEmail,
                        BillingDetailsAddress: data.patientAddress,
                        BillingDetailsPhone: data.patientCellularPhone
                    };

                    for (const name in campos) {
                        const input = form.querySelector(`[name="${name}"]`);
                        if (input) input.value = campos[name] || '';
                    }

                    const collapseDiv = document.getElementById('facturacion-extra');
                    if (collapseDiv) new bootstrap.Collapse(collapseDiv, { toggle: true });
                })
                .catch(() => Swal.fire('Error', 'Hubo un error al obtener los datos del paciente.', 'error'));
        }

        function limpiarFormulario() {
            const form = document.getElementById('billingForm');
            const campos = ['BillingDetailsNames', 'BillingDetailsCiNumber', 'BillingDetailsDocumentType',
                          'BillingDetailsEmail', 'BillingDetailsAddress', 'BillingDetailsPhone'];

            campos.forEach(campo => {
                const input = form.querySelector(`[name="${campo}"]`);
                if (input) input.value = '';
            });
        }
    </script>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <script>
            Swal.fire({
                title: '¡Éxito!',
                text: '@successMessage',
                icon: 'success',
                confirmButtonText: 'OK',
                timer: 3000
            });
        </script>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <script>
            Swal.fire({
                title: 'Error',
                text: '@errorMessage',
                icon: 'error',
                confirmButtonText: 'OK'
            });
        </script>
    }
}