@model List<FacturaEmitidaDTO>

@{
    ViewData["Title"] = "Facturas Emitidas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border">
            <div class="card-header bg-light">
                <h4 class="card-title mb-0">
                    <i class="mdi mdi-receipt-text-outline me-2"></i> Facturas Emitidas
                </h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="facturas-table" class="table table-hover table-bordered align-middle table-striped w-100">
                        <thead class="table-light">
                            <tr>
                                <th><i class="mdi mdi-pound"></i> N° de factura</th>
                                <th><i class="mdi mdi-calendar-clock-outline"></i> Fecha</th>
                                <th><i class="mdi mdi-account-outline"></i> Paciente</th>
                                <th><i class="mdi mdi-shield-account-outline"></i> Aseguradora</th>
                                <th><i class="mdi mdi-cash-multiple"></i> Subtotal</th>
                                <th><i class="mdi mdi-bank"></i> Aseguradora</th>
                                <th><i class="mdi mdi-account-cash-outline"></i> Copago</th>
                                <th><i class="mdi mdi-credit-card-outline"></i> Pago</th>
                                <th><i class="mdi mdi-printer"></i> Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.SecuencialFormateado</td>
                                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@item.Paciente</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Aseguradora) ? "—" : item.Aseguradora)</td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary">
                                                $@item.Subtotal.ToString("F2")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-success-subtle text-success">
                                                $@item.TotalAseguradora.ToString("F2")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-danger-subtle text-danger">
                                                $@item.TotalCopago.ToString("F2")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-uppercase">@item.MetodoPago</span>
                                        </td>
                                        <td>
                                            @if (item.Origen == "LOCAL" && item.FacturaId > 0)
                                            {
                                                <a href="@Url.Action("NotaVentaConTablaDinamica", "Billing", new { facturaId = item.FacturaId })"
                                                   class="btn btn-sm btn-soft-primary"
                                                   title="Imprimir Nota de Venta">
                                                    <i class="mdi mdi-printer"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">
                                        <i class="mdi mdi-alert-outline me-1"></i> No se encontraron facturas emitidas.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"
            integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
            crossorigin="anonymous"></script>

    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>

    <script>
        $(function() {
            $('#facturas-table').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.1/i18n/es-ES.json' },
                responsive: true,
                pageLength: 10,
                order: [[1, 'desc']],
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="mdi mdi-file-excel-outline"></i> Excel',
                        className: 'btn btn-sm btn-success',
                      exportOptions: {
          // Lista todos los índices que quieres exportar:
          columns: [ 1, 2, 3, 4, 5, 6, 7, 8]
        }
                        
                    },
                    {
                        extend: 'csvHtml5',
                        text: '<i class="mdi mdi-file-delimited-outline"></i> CSV',
                        className: 'btn btn-sm btn-primary',
                        exportOptions: { columns: [':visible', ':hidden'] }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="mdi mdi-file-pdf-outline"></i> PDF',
                        className: 'btn btn-sm btn-danger',
                        orientation: 'landscape',
                        pageSize: 'LETTER',
                        exportOptions: { columns: [':visible', ':hidden'] }
                    },
                    {
                        extend: 'print',
                        text: '<i class="mdi mdi-printer"></i> Imprimir',
                        className: 'btn btn-sm btn-secondary',
                        exportOptions: { columns: [':visible', ':hidden'] }
                    }
                ]
            });
        });
    </script>
}