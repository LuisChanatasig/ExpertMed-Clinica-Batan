@model IEnumerable<ExpertMed.Models.PatientDTO>

@{
    ViewBag.Title = "Listado de Pacientes";
    ViewBag.pTitle = "Listado de Pacientes";
    ViewBag.pageTitle = "Listado de Pacientes";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

@using Microsoft.AspNetCore.Http
@{
    var perfilId = ViewContext.HttpContext.Session.GetInt32("PerfilId") ?? 0;
    var usuarioId = ViewContext.HttpContext.Session.GetInt32("UsuarioId") ?? 0;

    // Perfiles que ven la columna Doctor: Admin, Recepción, Gestión, Caja
    bool showDoctorCol = new[] { 1, 3, 4, 8 }.Contains(perfilId);
}

@section styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <style>
        /* Avatar */
        .patient-avatar {
            width: 34px;
            height: 34px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid var(--bs-primary-bg-subtle);
        }

        /* Columna acciones fija */
        .col-actions {
            width: 60px;
            text-align: center;
        }

        /* Spinner de búsqueda */
        .search-spinner {
            position: absolute;
            right: 42px;
            top: 50%;
            transform: translateY(-50%);
            display: none;
            pointer-events: none;
        }

        /* Fila inactiva */
        #patientsTable tbody tr.row-inactive td {
            opacity: .55;
        }

        /* Badge código */
        .badge-code {
            font-size: .72rem;
            letter-spacing: .04em;
        }
    </style>
}
<div class="row g-3">
    <div class="col-12">
        <div class="card shadow-sm border-0">

            <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2 py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="mdi mdi-account-multiple-outline me-2 text-primary"></i>Pacientes
                </h5>
                <a href="@Url.Action("NewPatient", "Patient")" class="btn btn-primary btn-sm">
                    <i class="bx bx-user-plus me-1"></i> Nuevo paciente
                </a>
            </div>

            <div class="card-body border-bottom py-2">
                <div class="row align-items-center g-2">

                    <div class="col-auto flex-grow-1" style="max-width:360px; position:relative;">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="mdi mdi-magnify text-muted"></i>
                            </span>
                            <input id="globalSearch" type="search" class="form-control border-start-0 ps-0"
                                   placeholder="Nombre, documento…" autocomplete="off" />
                            <div class="search-spinner">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            </div>
                            <button id="clearSearch" class="btn btn-outline-secondary" type="button" title="Limpiar">
                                <i class="mdi mdi-close"></i>
                            </button>
                        </div>
                        <div id="searchResults" class="text-muted" style="font-size:.75rem; min-height:1rem; margin-top:2px;"></div>
                    </div>

                    <div class="col-auto ms-auto">
                        <div id="exportButtons" class="btn-group btn-group-sm"></div>
                    </div>

                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="patientsTable"
                           class="table table-hover align-middle mb-0 w-100"
                           style="border-collapse:collapse;">
                        <thead class="table-light">
                            <tr>
                                <th class="d-none">ID</th>
                                <th class="ps-3">Código</th>
                                @if (showDoctorCol)
                                {
                                    <th>Doctor</th>
                                }
                                <th>Paciente</th>
                                <th>Documento</th>
                                <th>Email</th>
                                <th>Nacionalidad</th>
                                <th class="col-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                bool activo = p.PatientStatus == 1;
                                <tr data-patient-id="@p.PatientId" class="@(!activo ? "row-inactive" : "")">
                                    <td class="d-none">@p.PatientId</td>

                                    <td class="ps-3">
                                        <span class="badge bg-primary-subtle text-primary badge-code">@p.PatientCode</span>
                                    </td>

                                    @if (showDoctorCol)
                                    {
                                        <td>
                                            <span class="fw-medium @(string.IsNullOrEmpty(p.DoctorFullname) ? "text-muted fst-italic" : "")">
                                                @(string.IsNullOrEmpty(p.DoctorFullname) ? "Sin asignar" : p.DoctorFullname)
                                            </span>
                                        </td>
                                    }

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="~/assets/images/svg/medicUsers.svg"
                                                 alt="Avatar" class="patient-avatar flex-shrink-0">
                                            <div>
                                                <div class="fw-semibold text-primary lh-sm">
                                                    @p.PatientFirstsurname @p.PatientSecondlastname
                                                </div>
                                                <div class="text-muted small lh-sm">
                                                    @p.PatientFirstname @p.PatientMiddlename
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td><span class="font-monospace small">@p.PatientDocumentNumber</span></td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(p.PatientEmail))
                                        {
                                            <a href="mailto:@p.PatientEmail"
                                               class="text-decoration-none small text-truncate d-inline-block"
                                               style="max-width:180px;">
                                                @p.PatientEmail
                                            </a>
                                        }
                                    </td>

                                    <td class="small">@p.NationalityName</td>

                                    <td class="col-actions">
                                        <button class="btn btn-sm btn-outline-primary btn-actions"
                                                data-bs-toggle="modal"
                                                data-bs-target="#actionsModal"
                                                data-id="@p.PatientId"
                                                data-code="@p.PatientCode"
                                                data-name="@($"{p.PatientFirstname} {p.PatientFirstsurname}")"
                                                data-status="@p.PatientStatus"
                                                data-doctor-id="@(p.DoctorUserId ?? 0)"
                                                data-doctor-name="@p.DoctorFullname"
                                                title="Ver acciones">
                                            <i class="ri-settings-3-line"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="actionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-semibold">
                    <i class="mdi mdi-account-cog me-2 text-primary"></i>Acciones del Paciente
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body pt-2">

                <div class="rounded-3 bg-light border px-3 py-2 mb-3">
                    <div class="fw-semibold fs-6" id="m-name"></div>
                    <div class="text-muted small mt-1">
                        <i class="mdi mdi-identifier me-1"></i><span id="m-code"></span>
                        <span class="mx-2">·</span>
                        <i class="mdi mdi-doctor me-1"></i><span id="m-doctor-name"></span>
                    </div>
                </div>

                <div id="assignDoctorCta" class="alert alert-warning d-none d-flex gap-2 align-items-start py-2 px-3">
                    <i class="mdi mdi-account-alert-outline fs-5 mt-1 flex-shrink-0"></i>
                    <div>
                        <div class="fw-semibold small">Sin médico asignado</div>
                        <div class="text-muted small mb-2">Algunas acciones requieren un médico.</div>
                        <a id="goEditPatient" class="btn btn-sm btn-primary">Asignar médico</a>
                    </div>
                </div>

                <div id="actionButtons" class="d-grid gap-2"></div>

                <div id="statusBadge" class="mt-3"></div>

            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        (function () {
        'use strict';

        const PERFIL_ID  = @perfilId;
        const USUARIO_ID = @usuarioId;

        // ── Normalización de texto (sin acentos) ───────────────────────────
        const normalize = t => (t || '').toString().toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '');

        $.fn.dataTable.ext.type.search.string = d => normalize(d);

        // ── DataTable ──────────────────────────────────────────────────────
        const table = $('#patientsTable').DataTable({
        language : { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json' },
        responsive: true,
        stateSave : true,
        pageLength: 25,
        dom       : 'Blrtip',
        buttons   : [
        {
        extend   : 'excelHtml5',
        text     : '<i class="mdi mdi-file-excel me-1"></i>Excel',
        className: 'btn btn-sm btn-success',
        exportOptions: { columns: ':visible:not(.col-actions)' }
        },
        {
        extend     : 'pdfHtml5',
        text       : '<i class="mdi mdi-file-pdf-box me-1"></i>PDF',
        className  : 'btn btn-sm btn-danger',
        orientation: 'landscape',
        exportOptions: { columns: ':visible:not(.col-actions)' }
        }
        ]
        });

        table.buttons().container().appendTo('#exportButtons');

        // ── Búsqueda con debounce ──────────────────────────────────────────
        const $spinner = $('.search-spinner');

        function debounce(fn, ms) {
        let t;
        return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
        }

        const doSearch = debounce(term => {
        table.search(normalize(term)).draw();
        $spinner.hide();
        }, 280);

        $('#globalSearch').on('input', function () {
        $spinner.show();
        doSearch(this.value);
        });

        $('#clearSearch').on('click', function () {
        $('#globalSearch').val('').trigger('input').focus();
        });

        table.on('draw.dt', function () {
        const info = table.page.info();
        const msg  = info.recordsDisplay < info.recordsTotal
        ? `${info.recordsDisplay} resultado(s)` : '';
        $('#searchResults').text(msg);
        });

        // ── Modal de acciones ──────────────────────────────────────────────
        $('#actionsModal').on('show.bs.modal', function (event) {
        const btn = $(event.relatedTarget);
        const p = {
        id     : btn.data('id'),
        code   : btn.data('code'),
        name   : btn.data('name'),
        status : Number(btn.data('status')),
        docId  : Number(btn.data('doctor-id')) || 0,
        docName: btn.data('doctor-name') || 'Sin asignar'
        };

        const isAssigned      = p.docId > 0;
        const responsibleDocId = isAssigned ? p.docId : (PERFIL_ID === 2 ? USUARIO_ID : 0);
        const editUrl = `@Url.Action("UpdatePatient", "Patient")?id=${p.id}&returnUrl=${encodeURIComponent(window.location.pathname)}`;

        $('#m-name').text(p.name);
        $('#m-code').text(p.code);
        $('#m-doctor-name').text(p.docName);
        $('#goEditPatient').attr('href', editUrl);
        $('#assignDoctorCta').toggleClass('d-none', isAssigned);

        const $btns = $('#actionButtons').empty();

        if (p.status === 1) {
        const emergencyDisabled = responsibleDocId === 0;
        $btns.append(`
        <button class="btn btn-danger"
        ${emergencyDisabled ? 'disabled title="Asigna un médico para esta acción"' : ''}
        onclick="createEmergency(${p.id}, ${responsibleDocId})">
        <i class="ri-alert-line me-2"></i>Cita de Emergencia
        </button>
        <a href="${editUrl}" class="btn btn-info">
        <i class="ri-edit-line me-2"></i>Editar / Agendar
        </a>
        <button class="btn btn-outline-warning" onclick="changeStatus(${p.id}, 0)">
        <i class="ri-pause-circle-line me-2"></i>Desactivar Paciente
        </button>
        `);
        } else {
        $btns.append(`
        <button class="btn btn-success" onclick="changeStatus(${p.id}, 1)">
        <i class="ri-play-circle-line me-2"></i>Activar Paciente
        </button>
        <a href="${editUrl}" class="btn btn-info">
        <i class="ri-edit-line me-2"></i>Editar Datos
        </a>
        `);
        }

        $('#statusBadge').html(p.status === 1
        ? `<span class="badge bg-success-subtle text-success border border-success-subtle">
        <i class="mdi mdi-check-circle me-1"></i>Paciente activo
        </span>`
        : `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
        <i class="mdi mdi-pause-circle me-1"></i>Paciente inactivo
        </span>`
        );
        });

        // ── Cambio de estado ───────────────────────────────────────────────
        window.changeStatus = function (id, st) {
        Swal.fire({
        title            : '¿Confirmar cambio de estado?',
        icon             : 'question',
        showCancelButton : true,
        confirmButtonText: 'Sí, cambiar',
        cancelButtonText : 'Cancelar'
        }).then(r => {
        if (!r.isConfirmed) return;
        const f = Object.assign(document.createElement('form'), {
        method: 'POST',
        action: '@Url.Action("ChangePatientStatus", "Patient")'
        });
        f.innerHTML = `<input type="hidden" name="patientId" value="${id}">
        <input type="hidden" name="status"    value="${st}">`;
        document.body.appendChild(f);
        f.submit();
        });
        };

        // ── Cita de emergencia ─────────────────────────────────────────────
        window.createEmergency = function (pid, did) {
        Swal.fire({
        title           : '¿Crear cita de emergencia?',
        text            : 'Se agendará una atención inmediata.',
        icon            : 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText : 'Sí, crear',
        cancelButtonText  : 'Cancelar'
        }).then(r => {
        if (!r.isConfirmed) return;
        const now = new Date();
        fetch(`@Url.Action("CreateAppointment", "Appointment")?doctorUserId=${did}`, {
        method : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify({
        appointmentDate     : now.toISOString().split('T')[0],
        appointmentHour     : now.toTimeString().substring(0, 5),
        appointmentPatientid: pid,
        appointmentStatus   : 5
        })
        })
        .then(res => res.json())
        .then(data => {
        if (data.success) {
        if (data.whatsappUrl) window.open(data.whatsappUrl, '_blank');
        Swal.fire('¡Éxito!', 'Cita de emergencia creada.', 'success')
        .then(() => location.reload());
        } else {
        Swal.fire('Error', data.message || 'No se pudo crear la cita.', 'error');
        }
        })
        .catch(() => Swal.fire('Error', 'Error de conexión. Intenta nuevamente.', 'error'));
        });
        };

        // ── Notificaciones TempData ────────────────────────────────────────
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <text>
                Swal.fire({
                title: '¡Éxito!',
                text : '@Html.Raw(successMessage)',
                icon : 'success',
                timer: 3000,
                showConfirmButton: false
                });
            </text>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <text>
                Swal.fire({ title: 'Error', text: '@Html.Raw(errorMessage)', icon: 'error' });
            </text>
        }

        }());
    </script>
}
