@using Microsoft.AspNetCore.Http
@model NewPatientViewModel

@{
    ViewBag.Title = "Registro Rápido de Paciente";
    ViewBag.pTitle = "Pacientes";
    ViewBag.pageTitle = "Nuevo Registro";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var usuarioId = ViewContext.HttpContext.Session.GetInt32("UsuarioId");
}

<div class="position-relative mx-n4 mt-n4">
    <div class="profile-wid-bg profile-setting-img">
        <img src="~/assets/images/auth-one-bg.jpg" class="profile-wid-img" alt="">
            <div class="overlay-content">
                <div class="text-end p-3">
                    <h1 class="text-white"><i class="ri-user-add-line"></i> Alta de Paciente</h1>
                    <p class="text-white-50">Registro administrativo inicial - Firma pendiente para cita.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xxl-12">
            <div class="card mt-xxl-n5 shadow-lg">
                <div class="card-body p-4">
                    <form asp-action="NewPatient" asp-controller="Patient" method="POST" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                    
                        @* Auditoría *@
                        <input type="hidden" name="PatientCode" id="PatientCode" value="EC-@DateTime.Now.Ticks">
                        <input type="hidden" name="PatientCreationuser" value="@usuarioId" />
                        <input type="hidden" name="PatientModificationuser" value="@usuarioId" />


                        <div class="row">
                            <div class="col-lg-12">
                                <div class="alert alert-info border-0 rounded-top mb-4">
                                    <i class="ri-information-line me-2"></i>
                                    Ingrese los datos básicos para crear el expediente. <strong>La firma legal se capturará cuando el paciente realice el Check-in en su cita.</strong>
                                </div>
                            </div>

                            @* Datos obligatorios *@
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Primer Apellido*</label>
                                    <input type="text" class="form-control" name="PatientFirstsurname" placeholder="Apellido" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Primer Nombre*</label>
                                    <input type="text" class="form-control" name="PatientFirstname" placeholder="Nombre" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Celular*</label>
                                    <input type="text" class="form-control" name="PatientCellularPhone" placeholder="09XXXXXXXX" required>
                                </div>
                            </div>

                            @* Campos con valores predeterminados (Ocultos para agilizar) *@
                            <div style="display:none;">
                                <input type="text" name="PatientDocumentnumber" value="0000000000">
                                <input type="date" name="PatientBirthdate" value="2000-01-01">
                                <input type="email" name="PatientEmail" value="pendiente@expertmed.ec">
                                <input type="text" name="PatientAddress" value="Quito, Ecuador">
                                <select name="PatientDocumenttype">
                                    @foreach (var dt in Model.DocumentTypes)
                                    {
                                        <option value="@dt.CatalogId">@dt.CatalogName</option>
                                    }
                                </select>
                                <select name="PatientGender">
                                    @foreach (var gt in Model.GenderTypes)
                                    {
                                        <option value="@gt.CatalogId">@gt.CatalogName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="@Url.Action("PatientList", "Patient")" class="btn btn-light">Cancelar</a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="ri-save-line me-1"></i> Crear Expediente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @section scripts {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            // Mensajes del servidor
            const successMessage = "@successMessage";
            const errorMessage = "@errorMessage";

            if (errorMessage) Swal.fire('Error', errorMessage, 'error');
            if (successMessage) {
            Swal.fire({
            title: '¡Registrado!',
            text: successMessage,
            icon: 'success',
            confirmButtonText: 'Ir a lista de pacientes'
            }).then(() => {
            window.location.href = '@Url.Action("PatientList", "Patient")';
            });
            }

            // Validación de Bootstrap
            (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
            if (!form.checkValidity()) {
            event.preventDefault()
            event.stopPropagation()
            }
            form.classList.add('was-validated')
            }, false)
            })
            })()
        </script>
    }