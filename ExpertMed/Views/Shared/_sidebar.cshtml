@{
    // Nombre completo para saludo
    var nombreCompleto = $"{(usuarioNombre ?? "").Trim()} {(usuarioApellido ?? "").Trim()}".Trim();

    // Rutas rápidas (/ir <modulo>)
    var routes = new Dictionary<string, string>
    {
        // Inicio
        ["inicio"] = Url.Action("Index", "Home"),

        // Pacientes
        ["pacientes"] = Url.Action("PatientList", "Patient"),
        ["lista pacientes"] = Url.Action("PatientList", "Patient"),
        ["nuevo paciente"] = Url.Action("NewPatient", "Patient"),

        // Agenda / Citas
        ["agenda"] = Url.Action("AppointmentList", "Appointment"),
        ["citas"] = Url.Action("AppointmentList", "Appointment"),
        ["lista de citas"] = Url.Action("AppointmentList", "Appointment"),
        ["nueva cita"] = Url.Action("PatientList", "Patient"),

        // Consultas
        ["consultas"] = Url.Action("ConsultationList", "Consultation"),
        ["historial consultas"] = Url.Action("ConsultationList", "Consultation"),
        ["nueva consulta"] = Url.Action("AppointmentList", "Appointment"),

        // Laboratorio
        ["laboratorio"] = Url.Action("LaboratoryList", "Laboratorio"),
        ["pendientes laboratorio"] = Url.Action("LaboratoryList", "Laboratorio"),
        ["historial laboratorio"] = Url.Action("LaboratoryHistory", "Laboratorio"),
