        new { selector = "#navbar-nav > li .nav-link.menu-link[href='#sidebarUsuarios']",          html = "<div class='fw-bold mb-1'>Usuarios</div><div>Altas y gestión de usuarios.</div>",                           position = "right" },
        new { selector = "#navbar-nav > li .nav-link.menu-link[href='#sidebarReportes']",          html = "<div class='fw-bold mb-1'>Reportes</div><div>Dashboard de consultas y métricas.</div>",                     position = "right" },
        new { selector = "#navbar-nav > li .nav-link.menu-link[href='#sidebarFisioterapia']",      html = "<div class='fw-bold mb-1'>Fisioterapia</div><div>Agenda e historial de terapias.</div>",                    position = "right" },
        new { selector = "#navbar-nav > li .nav-link.menu-link[href='#sidebarFacturacion']",       html = "<div class='fw-bold mb-1'>Facturación</div><div>Consulta de facturas emitidas.</div>",                      position = "right" }
    };

    // Texto de ayuda del menú según perfil
    var activas = new List<string>();
    if (perfilId == 1 || perfilId == 4)
        activas.AddRange(new[] { "Consultorios", "Establecimientos", "Usuarios", "Pacientes", "Agenda", "Consultas", "Laboratorio", "Resultados (Lab)", "Imágenes", "Resultados (Imágenes)", "Reportes", "Fisioterapia", "Facturación" });
    else if (perfilId == 2)
        activas.AddRange(new[] { "Pacientes", "Agenda", "Consultas", "Laboratorio", "Resultados (Lab)", "Imágenes", "Resultados (Imágenes)", "Fisioterapia" });
    else if (perfilId == 3)
        activas.AddRange(new[] { "Agenda" });
    else if (perfilId == 5)
        activas.AddRange(new[] { "Imágenes", "Resultados (Imágenes)" });
    else if (perfilId == 6)
        activas.AddRange(new[] { "Laboratorio", "Resultados (Lab)" });
    else if (perfilId == 7)
        activas.AddRange(new[] { "Fisioterapia" });
    else if (perfilId == 8)
        activas.AddRange(new[] { "Pacientes", "Agenda", "Facturación" });

    var menuHelpHtml =
        $"<strong>Secciones disponibles para tu perfil:</strong><br>• {string.Join("<br>• ", activas)}" +
        "<br><br><em>Puedes escribir <code>/menu</code> para ver el tour del menú o <code>/ir citas</code>, <code>/ir pacientes</code>, <code>/ir facturacion</code>, etc.</em>";

    // Perfil (texto breve)
    string perfilTexto = perfilId switch
    {
        1 => "Administrador: gestión total del sistema.",
        2 => "Doctor: pacientes, agenda y consultas.",
        3 => "Recepción: agenda y gestión de citas.",
        4 => "Gestión: citas, consultas y reportes.",
        5 => "Imágenes: estudios e informes radiológicos.",
        6 => "Laboratorio: solicitudes y resultados.",
        7 => "Fisioterapia: terapias y seguimiento.",
        8 => "Caja/Facturación: pacientes, agenda y facturación.",
        _ => "Perfil no identificado."
    };

    // Serializaciones seguras para JS
    var stepsMenuJson = JsonSerializer.Serialize(stepsMenu);
    var routesJson = JsonSerializer.Serialize(routes);
    var menuHelpJson = JsonSerializer.Serialize(menuHelpHtml);
    var nombreJson = JsonSerializer.Serialize(nombreCompleto);
    var perfilJson = JsonSerializer.Serialize(perfilTexto);
}

<script>
    // Opciones del bot inyectadas desde el menú (por perfil)
    (function () {
      // Rutas rápidas para /ir <módulo>
      window.EBG_ROUTES = Object.assign({}, window.EBG_ROUTES || {}, @Html.Raw(routesJson));

      // Pasos del tour del menú (+ ayuda)
      window.EBG_OPTIONS = Object.assign({}, window.EBG_OPTIONS || {}, {
        userName: @Html.Raw(nombreJson),
        profileText: @Html.Raw(perfilJson),
        greetMessage: "¡Hola, {name}! ¿Qué deseas hacer hoy?",
        extraTours: Object.assign({}, (window.EBG_OPTIONS && window.EBG_OPTIONS.extraTours) || {}, {
          menu: @Html.Raw(stepsMenuJson) // se activa con /menu
        }),
        menuHelp: @Html.Raw(menuHelpJson)
      });

      // Si por alguna razón no se inicializó en el _Layout, lo hacemos aquí de forma segura.
      if (window.ExpertBotGuide && typeof window.ExpertBotGuide.init === "function" && !window.__EB_MENU_INIT__) {
        window.__EB_MENU_INIT__ = true;
        window.ExpertBotGuide.init(Object.assign({
          storagePrefix: "exp.menu",
          routes: (window.EBG_ROUTES || {})
        }, window.EBG_OPTIONS || {}));
      }
    })();
</script>
