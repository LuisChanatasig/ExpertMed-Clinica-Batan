@using Microsoft.AspNetCore.Http
@model List<ExpertMed.Models.ConsultationGroupViewModel>

@{
    ViewBag.Title  = "Listado de Consultas";
    ViewBag.pTitle = "Listado de Consultas";
    ViewBag.pageTitle = "Listado de Consultas";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var perfilId       = ViewContext.HttpContext.Session.GetInt32("PerfilId");
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage   = TempData["ErrorMessage"]   as string;

    // Totales (preferimos ViewBag si el controller los calculó; si no, los calculamos aquí)
    var totalPacientes  = (int)(ViewBag.TotalPacientes  ?? Model.Count);
    var totalConsultas  = (int)(ViewBag.TotalConsultas  ?? Model.Sum(g => g.TotalConsultas));
    var totalPendientes = (int)(ViewBag.ConsultasPendientes ?? Model.Sum(g => g.Consultas.Count(c => c.AppointmentStatus != 4)));

    int currentPage  = ViewBag.Page      ?? 1;
    int totalPages   = ViewBag.TotalPages ?? 1;
    int pageSize     = ViewBag.PageSize   ?? 10;
    bool hasPrevious = ViewBag.HasPrevious ?? false;
    bool hasNext     = ViewBag.HasNext     ?? false;
    string? patientId = Context.Request.Query["patientId"];
}

@section styles {
    <style>
        /* ── Badges ─────────────────────────────────────── */
        .status-badge {
            font-size: 0.72rem;
            padding: 0.3rem 0.6rem;
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        /* ── Tarjeta de grupo ────────────────────────────── */
        .grupo-consulta {
            transition: box-shadow 0.2s ease;
        }
        .grupo-consulta:hover {
            box-shadow: 0 0.4rem 0.9rem rgba(0, 0, 0, 0.07);
        }

        /* ── Paginación ──────────────────────────────────── */
        .pagination-bar {
            border-top: 1px solid var(--bs-border-color);
        }

        /* ── Opción destacada en el select ───────────────── */
        .new-form-highlight {
            color: #0d6efd;
            font-weight: 600;
        }
    </style>
}

<!-- ══════════════════════════════════════════════════════════
     URLs inyectadas para el archivo JS externo.
     Se usa Json.Serialize para escapar correctamente cualquier
     carácter especial y evitar XSS.
     ══════════════════════════════════════════════════════════ -->
<script>
    window.AppUrls = {
        consultationUpdate : @Html.Raw(Json.Serialize(Url.Action("ConsultationUpdate",  "Consultation"))),
        consultationDetails: @Html.Raw(Json.Serialize(Url.Action("ConsultationDetails", "Consultation"))),
        consultationList   : @Html.Raw(Json.Serialize(Url.Action("ConsultationList",    "Consultation"))),
        medicalCertificate : @Html.Raw(Json.Serialize(Url.Action("MedicalCertificate",  "Documents"))),
        medicalForm        : @Html.Raw(Json.Serialize(Url.Action("MedicalForm",          "Documents"))),
        medicalForm2       : @Html.Raw(Json.Serialize(Url.Action("MedicalForm2",         "Documents"))),
        medicationRecipe   : @Html.Raw(Json.Serialize(Url.Action("MedicationRecipe",    "Documents"))),
        laboratoryDoc      : @Html.Raw(Json.Serialize(Url.Action("LaboratoryDoc",        "Documents"))),
        imageDoc           : @Html.Raw(Json.Serialize(Url.Action("ImageDoc",             "Documents")))
    };
</script>

<div class="row">
    <div class="col-lg-12">
        <div class="card">

            <!-- ── Header ───────────────────────────────────── -->
            <div class="card-header">
                <div class="row align-items-center g-3">

                    <div class="col-md-3">
                        <h5 class="card-title mb-0">
                            <i class="mdi mdi-clipboard-text-multiple-outline"></i>
                            Consultas Médicas
                        </h5>
                    </div>

                    <div class="col-md-4">
                        <input type="search"
                               id="consultaSearch"
                               class="form-control form-control-sm"
                               placeholder="🔍 Buscar paciente, médico o especialidad..."
                               autocomplete="off" />
                    </div>

                    <div class="col-md-5">
                        <div class="d-flex justify-content-end gap-3 align-items-center">
                            <!-- Selector de tamaño de página -->
                            <div>
                                <select id="pageSizeSelect"
                                        class="form-select form-select-sm"
                                        onchange="changePageSize()"
                                        aria-label="Registros por página">
                                    @foreach (var size in new[] { 10, 25, 50, 100 })
                                    {
                                        <option value="@size" selected="@(pageSize == size)">
                                            @size / pág.
                                        </option>
                                    }
                                </select>
                            </div>
                            <!-- Contadores -->
                            <div class="text-center">
                                <small class="text-muted d-block">Pacientes</small>
                                <strong class="fs-5 text-primary">@totalPacientes</strong>
                            </div>
                            <div class="text-center">
                                <small class="text-muted d-block">Consultas</small>
                                <strong class="fs-5 text-info">@totalConsultas</strong>
                            </div>
                            <div class="text-center">
                                <small class="text-muted d-block">Pendientes</small>
                                <strong class="fs-5 text-danger">@totalPendientes</strong>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ── Paginación superior ───────────────────────── -->
            <div class="d-flex justify-content-between align-items-center px-3 py-2 pagination-bar">
                <span class="text-muted small">
                    Página @currentPage de @totalPages
                </span>
                <div class="btn-group btn-group-sm">
                    <a asp-action="ConsultationList"
                       asp-route-patientId="@patientId"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-pageSize="@pageSize"
                       class="btn btn-outline-secondary @(!hasPrevious ? "disabled" : "")"
                       aria-disabled="@(!hasPrevious)">← Anterior</a>
                    <a asp-action="ConsultationList"
                       asp-route-patientId="@patientId"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-pageSize="@pageSize"
                       class="btn btn-outline-primary @(!hasNext ? "disabled" : "")"
                       aria-disabled="@(!hasNext)">Siguiente →</a>
                </div>
            </div>

            <!-- ── Cuerpo: lista de grupos ───────────────────── -->
            <div class="card-body">

                @if (Model != null && Model.Any())
                {
                    @foreach (var (grupo, idx) in Model.Select((g, i) => (g, i + 1)))
                    {
                        var first      = grupo.PrimeraConsulta;
                        var collapseId = $"collapseConsulta{idx}";

                        // Texto de búsqueda precalculado en el servidor (evita recorrer el DOM en JS)
                        var searchText = $"{grupo.PacienteNombre} {grupo.UltimaMedicoNombre} {first?.ConsultationSpecialityNavigation?.SpecialityName}".ToLower();

                        <div class="mb-3 border rounded grupo-consulta" data-search="@searchText">

                            <!-- Cabecera del grupo -->
                            <div class="bg-light px-3 py-2">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                            <strong>
                                                <i class="mdi mdi-account"></i> @grupo.PacienteNombre
                                            </strong>
                                            <span class="badge bg-secondary status-badge">
                                                @grupo.TotalConsultas consulta@(grupo.TotalConsultas > 1 ? "s" : "")
                                            </span>
                                            @if (first != null)
                                            {
                                                var esF  = first.AppointmentStatus == 4;
                                                <span class="badge @(esF ? "bg-success" : "bg-danger") status-badge">
                                                    <i class="mdi @(esF ? "mdi-check-circle" : "mdi-alert-circle")"></i>
                                                    @(esF ? "Finalizada" : "Pendiente")
                                                </span>
                                            }
                                        </div>
                                        @if (first != null)
                                        {
                                            <div class="text-muted small">
                                                <i class="mdi mdi-stethoscope"></i> Médico: @grupo.UltimaMedicoNombre
                                            </div>
                                            <div class="text-muted small">
                                                <i class="mdi mdi-calendar-clock"></i>
                                                Última consulta: @(grupo.UltimaConsulta?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-4 text-end d-flex justify-content-end gap-2 flex-wrap">
                                        <button class="btn btn-sm btn-soft-info"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="false"
                                                aria-controls="@collapseId">
                                            <i class="mdi mdi-eye-outline"></i> Ver detalles
                                        </button>
                                        <a href="@Url.Action("AppointmentList", "Appointment")"
                                           class="btn btn-sm btn-soft-primary">
                                            <i class="bx bx-user-plus"></i> Nueva
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Detalle colapsable -->
                            <div class="collapse px-2 py-2" id="@collapseId">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover table-bordered align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                @if (perfilId == 1 || perfilId == 2)
                                                {
                                                    <th scope="col">Secuencial</th>
                                                    <th scope="col">Médico</th>
                                                }
                                                <th scope="col">H. Clínica</th>
                                                <th scope="col">Fecha</th>
                                                <th scope="col">Especialidad</th>
                                                <th scope="col">Motivo</th>
                                                <th scope="col">Tipo</th>
                                                <th scope="col">Estado</th>
                                                <th scope="col">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var consulta in grupo.Consultas)
                                            {
                                                var finalizada = consulta.AppointmentStatus == 4;
                                                var hoy        = consulta.ConsultationCreationdate?.Date == DateTime.Today;

                                                <tr>
                                                    @if (perfilId == 1 || perfilId == 2)
                                                    {
                                                        <td>@consulta.ConsultationId</td>
                                                        <td>
                                                            @if (consulta.ConsultationUsercreateNavigation != null)
                                                            {
                                                                <div class="d-flex align-items-center fw-medium">
                                                                    <img src="~/assets/images/svg/medicUsers.svg"
                                                                         alt="Médico"
                                                                         class="avatar-xxs me-2"
                                                                         loading="lazy" />
                                                                    @consulta.ConsultationUsercreateNavigation.UsersNames
                                                                    @consulta.ConsultationUsercreateNavigation.UsersSurcenames
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">No asignado</span>
                                                            }
                                                        </td>
                                                    }
                                                    <td>@consulta.ConsultationHistoryclinic</td>
                                                    <td>@(consulta.ConsultationCreationdate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                    <td>@(consulta.ConsultationSpecialityNavigation?.SpecialityName ?? "No especificada")</td>
                                                    <td>@(consulta.ConsultationReason ?? "—")</td>
                                                    <td>
                                                        @{
                                                            var (tipoCss, tipoLabel) = consulta.ConsultationType switch
                                                            {
                                                                1 => ("bg-success-subtle text-success", "Principal"),
                                                                2 => ("bg-info-subtle text-info",       "Seguimiento"),
                                                                _ => ("bg-secondary-subtle text-secondary", "Otro"),
                                                            };
                                                        }
                                                        <span class="badge @tipoCss">@tipoLabel</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(finalizada ? "bg-success" : "bg-danger") status-badge">
                                                            <i class="mdi @(finalizada ? "mdi-check" : "mdi-clock-outline")"></i>
                                                            @(finalizada ? "Finalizada" : "Pendiente")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (finalizada)
                                                        {
                                                            @if (hoy)
                                                            {
                                                                <a href="@Url.Action("ConsultationUpdate", "Consultation", new { consultationId = consulta.ConsultationId })"
                                                                   class="btn btn-sm btn-soft-warning me-1">
                                                                    <i class="ri-edit-line"></i> Editar
                                                                </a>
                                                            }
                                                            <button type="button"
                                                                    class="btn btn-sm btn-soft-success"
                                                                    onclick="openOptionModal(@consulta.ConsultationId, @consulta.AppointmentStatus)">
                                                                <i class="ri-eye-line"></i> Revisar
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-soft-warning"
                                                                    onclick="openOptionModal(@consulta.ConsultationId, @consulta.AppointmentStatus)">
                                                                <i class="ri-edit-line"></i> Completar
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="mdi mdi-information-outline fs-1 d-block mb-2"></i>
                        No hay consultas registradas.
                    </div>
                }

            </div><!-- /card-body -->

            <!-- ── Paginación inferior ───────────────────────── -->
            <div class="d-flex justify-content-between align-items-center px-3 py-2 pagination-bar">
                <span class="text-muted small">
                    Página @currentPage de @totalPages
                </span>
                <div class="btn-group btn-group-sm">
                    <a asp-action="ConsultationList"
                       asp-route-patientId="@patientId"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-pageSize="@pageSize"
                       class="btn btn-outline-secondary @(!hasPrevious ? "disabled" : "")"
                       aria-disabled="@(!hasPrevious)">← Anterior</a>
                    <a asp-action="ConsultationList"
                       asp-route-patientId="@patientId"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-pageSize="@pageSize"
                       class="btn btn-outline-primary @(!hasNext ? "disabled" : "")"
                       aria-disabled="@(!hasNext)">Siguiente →</a>
                </div>
            </div>

        </div><!-- /card -->
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     Modal: opciones de consulta
     ══════════════════════════════════════════════════════════ -->
<div class="modal flip" id="optionModal" tabindex="-1"
     aria-labelledby="optionModalLabel" aria-modal="true" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">

            <input type="hidden" id="consultationId"  name="ConsultationId" />
            <input type="hidden" id="perfiltIdInput"  value="@perfilId"     name="perfil" />

            <div class="modal-header">
                <h5 class="modal-title" id="optionModalLabel">
                    ¿Qué desea hacer con esta consulta?
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-6">
                        <button type="button"
                                class="btn btn-soft-info btn-label btn-sm w-100 waves-effect waves-light"
                                onclick="openReviewConsulta()">
                            <i class="ri-eye-fill label-icon align-middle fs-16 me-2"></i>
                            Revisar Consulta
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button"
                                class="btn btn-soft-success btn-label btn-sm w-100 waves-effect waves-light"
                                onclick="openModalDocument()">
                            <i class="ri-file-text-fill label-icon align-middle fs-16 me-2"></i>
                            Generar Documento
                        </button>
                    </div>
                    <div class="col-12">
                        <button id="btnFinishConsult"
                                type="button"
                                class="btn btn-success w-100 d-none"
                                onclick="finishConsultation()">
                            <i class="ri-check-line me-1"></i> Terminar Consulta
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     Modal: opciones de documento
     ══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="optionsDocuments" tabindex="-1"
     aria-labelledby="optionsDocumentsLabel" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="optionsDocumentsLabel">
                    ¿Qué documento desea generar?
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <select class="form-select"
                        id="documentType"
                        aria-label="Seleccione un documento"
                        onchange="enableDownloadButton()">
                    <option value="" selected disabled>Seleccione un documento</option>
                    <option value="justificante">Certificado Médico</option>
                    <option value="formulario">Formulario Médico antiguo</option>
                    <option value="formulario2" class="new-form-highlight">Formulario Médico 2026 ✨</option>
                    <option value="receta">Receta</option>
                    <option value="laboratorio">Laboratorio</option>
                    <option value="imagen">Imagen</option>
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary"
                        id="downloadButton"
                        onclick="downloadDocument()"
                        disabled>
                    <span id="downloadText">Descargar</span>
                    <span id="downloadSpinner"
                          class="spinner-border spinner-border-sm d-none"
                          role="status" aria-hidden="true"></span>
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     Scripts
     ══════════════════════════════════════════════════════════ -->
@section scripts {
    <!-- SweetAlert2 (sólo se carga si hay mensajes que mostrar) -->
    @if (!string.IsNullOrEmpty(successMessage) || !string.IsNullOrEmpty(errorMessage))
    {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    }

    <!-- JS propio de esta vista (sin jQuery) -->
    <script src="~/js/consultationlist.js" defer></script>

    <!-- Notificaciones (después de que el DOM y Swal estén listos) -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                window.showToast('success', @Html.Raw(Json.Serialize(successMessage)));
            });
        </script>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                window.showToast('error', @Html.Raw(Json.Serialize(errorMessage)));
            });
        </script>
    }
}
