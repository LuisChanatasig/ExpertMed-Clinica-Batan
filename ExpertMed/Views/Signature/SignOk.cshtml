@model List<string>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Firma Registrada - ExpertMed</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f4f7f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .success-card {
            max-width: 500px;
            margin: auto;
            border-radius: 20px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .icon-box {
            width: 70px;
            height: 70px;
            background: #d1e7dd;
            color: #198754;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin: 0 auto 20px;
        }

        .download-item {
            border: 1px solid #e9ecef;
            border-radius: 12px;
            padding: 12px;
            transition: all 0.2s;
            background: #fff;
            text-decoration: none;
            color: inherit;
            display: block;
            margin-bottom: 10px;
        }

            .download-item:hover {
                border-color: #0d6efd;
                background: #f8f9ff;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>

    <div class="container p-3">
        <div class="card success-card text-center p-4">
            <div class="card-body">
                <div class="icon-box">✓</div>

                <h3 class="fw-bold text-dark">¡Proceso Completado!</h3>
                <p class="text-muted small">Su firma ha sido vinculada legalmente a los siguientes documentos:</p>

                @if (Model != null && Model.Any())
                {
                    <div class="text-start mt-4 mb-4">
                        <label class="small text-uppercase fw-bold text-muted mb-2 d-block">Descargar mis copias:</label>
                        @foreach (var file in Model)
                        {
                            // Extraer el nombre original para mostrarlo más limpio
                            var fileName = System.IO.Path.GetFileName(file).Split('_').LastOrDefault();

                            <a href="@file" download class="download-item">
                                <div class="d-flex align-items-center">
                                    <div class="me-3 text-danger">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-file-earmark-pdf-fill" viewBox="0 0 16 16">
                                            <path d="M5.667 1.667L10 6.125V14.333c0 .368-.298.667-.667.667H3.333a.667.667 0 0 1-.666-.667V2.333c0-.368.298-.667.666-.667h2.334z" />
                                        </svg>
                                    </div>
                                    <div class="text-truncate" style="flex: 1; font-size: 0.85rem;">
                                        <strong>PDF Firmado</strong><br>
                                        <span class="text-muted small">@fileName</span>
                                    </div>
                                    <div class="text-primary">
                                        ↓
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning small">
                        La firma se registró, pero hubo un inconveniente al generar las copias descargables. Por favor, solicite sus documentos en recepción.
                    </div>
                }

                <hr class="my-4 opacity-25">

                <p class="small text-secondary mb-4">
                    Estos documentos también estarán disponibles en su historial clínico de ExpertMed.
                </p>

                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary fw-bold" onclick="window.close();">Finalizar</button>
                </div>
            </div>
        </div>
        <p class="text-center mt-4 text-muted small">© 2026 ExpertMed - Consultorios Integrales</p>
    </div>

</body>
</html>