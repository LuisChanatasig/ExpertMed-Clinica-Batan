@using System.Text.Json
@using System.Web
@model List<TherapyHistoryDTO>

@{
    ViewBag.Title = "Historial de Terapias";
    Layout = "_Layout";
}

<script>
    // Serialización segura del modelo
    const historialClinico = @Html.Raw(JsonSerializer.Serialize(Model));
</script>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between text-primary">
            <h4 class="mb-sm-0">Historial Clínico de Fisioterapia</h4>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header border-0 align-items-center d-flex">
        <h5 class="card-title mb-0 flex-grow-1">
            <i class="mdi mdi-clipboard-text-clock-outline text-primary me-2"></i>Seguimiento de Pacientes
        </h5>
        <div class="flex-shrink-0">
            <div class="input-group input-group-sm" style="width:300px;">
                <span class="input-group-text bg-light border-light">
                    <i class="ri-search-line"></i>
                </span>
                <input type="text" id="globalSearch" class="form-control bg-light border-light"
                       placeholder="Buscar por nombre, cédula o terapeuta...">
            </div>
        </div>
    </div>

    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            for (int pIdx = 0; pIdx < Model.Count; pIdx++)
            {
                var paciente = Model[pIdx];
                var safeId = "paciente_" + pIdx;

                <div class="grupo-historial card border mb-3 shadow-none">
                    <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center py-2">
                        <div class="d-flex align-items-center">
                            <div class="avatar-xs me-3">
                                <div class="avatar-title bg-soft-primary text-primary rounded-circle fw-bold">
                                    @paciente.NombrePaciente.Substring(0, 1).ToUpper()
                                </div>
                            </div>
                            <div>
                                <h6 class="mb-0 fs-14">@paciente.NombrePaciente</h6>
                                <small class="text-muted">
                                    C.I: @paciente.CedulaPaciente |
                                    <strong>@paciente.NombreSeguro</strong>
                                </small>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-primary shadow-none"
                                data-bs-toggle="collapse"
                                data-bs-target="#@safeId">
                            <i class="mdi mdi-eye-outline me-1"></i> Ver Sesiones
                        </button>
                    </div>

                    <div class="collapse" id="@safeId">
                        <div class="card-body p-0">
                            @for (int sIdx = 0; sIdx < paciente.Solicitudes.Count; sIdx++)
                            {
                                var solicitud = paciente.Solicitudes[sIdx];

                                <div class="p-3 border-bottom bg-white">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="fs-13">
                                            <span class="me-3">
                                                <i class="mdi mdi-doctor text-primary me-1"></i>
                                                <strong>@solicitud.TerapeutaNombre</strong>
                                            </span>
                                            <span class="badge bg-info-subtle text-info">
                                                <i class="mdi mdi-calendar me-1"></i>
                                                @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")
                                            </span>
                                        </div>

                                        <button class="btn btn-sm btn-soft-dark shadow-none"
                                                onclick="prepararImpresion(@pIdx, @sIdx)">
                                            <i class="mdi mdi-printer me-1"></i> Reporte de Evolución
                                        </button>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light fs-11 text-uppercase">
                                                <tr>
                                                    <th>#</th>
                                                    <th>Fecha / Hora</th>
                                                    <th>Terapia</th>
                                                    <th>Observaciones Iniciales</th>
                                                    <th width="180">Progreso Clínico</th>
                                                    <th width="50" class="text-center">Acción</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < solicitud.Sesiones.Count; i++)
                                                {
                                                    var sesion = solicitud.Sesiones[i];
                                                    <tr>
                                                        <td class="fw-medium">@(i + 1)</td>
                                                        <td class="fs-12">
                                                            <strong>@sesion.Fecha.ToString("dd/MM/yyyy")</strong><br />
                                                            <span class="text-muted">
                                                                @sesion.Hora.ToString(@"hh\:mm")
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-light text-body border">
                                                                @sesion.Tipo
                                                            </span>
                                                        </td>
                                                        <td class="fs-12 text-muted" style="max-width:200px;">
                                                            @sesion.Observaciones
                                                        </td>
                                                        <td>
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="progress progress-sm flex-grow-1" style="height:8px;">
                                                                    <div class="progress-bar @(sesion.AvancePorcentaje >= 100 ? "bg-success" : "bg-primary")"
                                                                         style="width:@sesion.AvancePorcentaje%"></div>
                                                                </div>
                                                                <span class="fs-12 fw-bold">@sesion.AvancePorcentaje%</span>
                                                            </div>
                                                        </td>
                                                        <td class="text-center">
                                                            <button class="btn btn-sm btn-icon btn-soft-primary shadow-none"
                                                                    onclick="abrirModalAvance(
                                                                                        @sesion.SessionId,
                                                                                        @sesion.AvancePorcentaje,
                                                                                        '@HttpUtility.JavaScriptStringEncode(sesion.AvanceNotas)')">
                                                                <i class="mdi mdi-pencil-outline fs-16"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="mdi mdi-folder-open-outline display-4 text-muted"></i>
                <h5 class="mt-3">Sin registros</h5>
                <p class="text-muted">No se han encontrado terapias agendadas.</p>
            </div>
        }
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAvance" style="width:450px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title text-primary">
            <i class="mdi mdi-chart-line me-2"></i>Registrar Evolución
        </h5>
        <button class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <form id="formAvance" class="flex-grow-1">
            <input type="hidden" id="modalSessionId" />

            <div class="mb-4 text-center bg-light p-3 rounded">
                <label class="fw-bold mb-3 d-block">Porcentaje de Recuperación</label>
                <input type="range" class="form-range" id="modalRange"
                       min="0" max="100" step="5"
                       oninput="rangeText.innerText = this.value + '%'">
                <span id="rangeText" class="badge bg-primary fs-3">0%</span>
            </div>

            <div class="mb-4">
                <label class="fw-bold">Evolución Clínica (SOAP)</label>
                <textarea id="modalNotas" class="form-control" rows="10"></textarea>
            </div>
        </form>

        <button onclick="guardarAvance(this)" class="btn btn-success btn-lg">
            Guardar Cambios
        </button>
    </div>
</div>

@section scripts {
    <script>
        const bsOffcanvas = new bootstrap.Offcanvas(
            document.getElementById('offcanvasAvance')
        );

        $('#globalSearch').on('keyup', function () {
            const val = this.value.toLowerCase();
            $('.grupo-historial').each(function () {
                const show = $(this).text().toLowerCase().includes(val);
                $(this).toggle(show);
                if (val.length > 2 && show) {
                    $(this).find('.collapse').addClass('show');
                }
            });
        });

        function prepararImpresion(pIdx, sIdx) {
            const paciente = historialClinico[pIdx];
            const solicitud = paciente.Solicitudes[sIdx];
            imprimirReporte(
                paciente.NombrePaciente,
                solicitud.TerapeutaNombre,
                solicitud.Sesiones
            );
        }

        // 🔑 EXPUESTO AL SCOPE GLOBAL
        window.prepararImpresion = prepararImpresion;

        function abrirModalAvance(id, avance, notas) {
            modalSessionId.value = id;
            modalRange.value = avance;
            rangeText.innerText = avance + '%';
            modalNotas.value = notas || '';
            bsOffcanvas.show();
        }

        function imprimirReporte(paciente, terapeuta, sesiones) {
            const win = window.open('', '_blank');
            win.document.write(`
                <h2>Informe de Evolución Clínica</h2>
                <p><b>Paciente:</b> ${paciente}</p>
                <p><b>Terapeuta:</b> ${terapeuta}</p>
                <hr>
                ${sesiones.map((s,i)=>`
                    <p><b>${i+1}.</b> ${new Date(s.Fecha).toLocaleDateString()} -
                    ${s.Tipo} - ${s.AvancePorcentaje}%</p>
                    <p>${s.AvanceNotas || 'Sin novedades'}</p>
                `).join('')}
            `);
            win.print();
        }
    </script>
}
